#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	chosen {
		zephyr,display = &oled;
		zmk,kscan = &kscan0;
		zmk,underglow = &led_strip;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		label = "KSCAN";

		diode-direction = "col2row";		
	};

	left_encoder: encoder_left {
		compatible = "alps,ec11";
		label = "LEFT_ENCODER";
	    a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	    b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <30>;
		status = "disabled";
	};

	right_encoder: encoder_right {
		compatible = "alps,ec11";
		label = "RIGHT_ENCODER";
	    a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    	b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <30>;
		status = "disabled";
	};

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
    };

    // Haptic feedback receive side - the dongle (central) triggers this
    // over BLE via zmk-split-peripheral-output-relay; drv2605_0 is
    // defined below in the pro_micro_i2c block. relay-channel 201 must
    // match klor_dongle.overlay's sender config exactly. Untested -
    // see MIGRATION_NOTES.md bring-up milestones.
    lra0: output_haptic_fb_0 {
        compatible = "zmk,output-haptic-feedback";
        #binding-cells = <0>;
        driver = "drv2605";
        device = <&drv2605_0>;
    };

    output_relay_config_201: output_relay_config_201 {
        compatible = "zmk,split-peripheral-output-relay";
        relay-channel = <201>;
        device = <&lra0>;
    };

    // Piezo beep receive side - same relay pattern as the haptic
    // feedback above, on a separate channel (202). pwm_piezo0 is
    // defined below via &pwm0. Untested - see MIGRATION_NOTES.md.
    pwm_piezo0: output_pwm_0 {
        compatible = "zmk,output-pwm";
        #binding-cells = <0>;
        /* 2kHz tone - audible range, not the 50Hz LED-dimming example
         * from zmk-output-behavior-listener's README */
        pwms = <&pwm0 0 PWM_HZ(2000) PWM_POLARITY_NORMAL>;
    };

    output_relay_config_202: output_relay_config_202 {
        compatible = "zmk,split-peripheral-output-relay";
        relay-channel = <202>;
        device = <&pwm_piezo0>;
    };
};

// Piezo (BZ1/BZ2 dual footprint, only one expected populated) on P1.06 -
// "last bottom pin from the left with USB-C on top, schematic pin 12"
// per hardware owner. PWM0 chosen since SPI3 (RGB) and the I2C TWIM
// bus (OLED/DRV2605) are already claimed - verify no conflict on your
// re-layout if bring-up shows otherwise.
&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

// RGB underglow (SK6812MINI-E x21, south-facing). This project only ever
// targets nice!nano v2 hardware, so this lives directly in the shared
// shield file rather than a boards/nice_nano_*.overlay per-board overlay -
// under ZMK's current Hardware Model V2 board naming, out-of-tree shields'
// boards/<board>.overlay auto-discovery for a plain "nice_nano" target no
// longer reliably triggers, so putting it here is both simpler and robust.
&pinctrl {
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
		};
	};

	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
			low-power-enable;
		};
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";

	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";

		/* SPI */
		reg = <0>; /* ignored, but necessary for SPI bindings */
		spi-max-frequency = <4000000>;

		/* WS2812 */
		chain-length = <21>; /* number of LEDs */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN
		                 LED_COLOR_ID_RED
		                 LED_COLOR_ID_BLUE>;
	};
};

&pro_micro_i2c {
	status = "okay";

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		label = "DISPLAY";
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		prechargep = <0x22>;
      		inversion-on;
	};

	// DRV2605L (untested hardware) driving the AAC ELV1411A LRA. No
	// address collision with the SSD1306 above (0x5a vs 0x3c). Uses
	// badjeff/zmk-drv2605-driver (via BFotouh's fork, see west.yml) so
	// zmk-output-behavior-listener's DRV2605 trigger code has a
	// sensor_driver_api-compatible device to call into - Zephyr's own
	// native ti,drv2605 haptics driver compiles fine but that listener
	// code is hard-wired to this community driver's custom sensor
	// attributes (DRV2605_ATTR_WAVEFORM/GO), not the native haptics
	// API. LRA resonant-frequency/voltage calibration (~150Hz, 2Vrms)
	// isn't a devicetree property here either way - chip-internal
	// closed-loop auto-resonance handles it at runtime. See
	// MIGRATION_NOTES.md bring-up milestones - untested hardware.
	drv2605_0: drv2605@5a {
		compatible = "badjeff,drv2605";
		reg = <0x5a>;

		/* Library to use, 0 = Empty, 1-5 are ERM, 6 is LRA. */
		library = <6>;

		/* switch to standby mode after idling for 1000ms */
		standby-ms = <1000>;
	};
};
