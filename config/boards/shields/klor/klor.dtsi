#include "klor_common.dtsi"
#include <physical_layouts.dtsi>

/ {
	chosen {
		zmk,physical-layout = &default_layout;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <4>;
		map = <
        RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,5) RC(3,6) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,7) RC(3,8) RC(3,9) RC(3,10)
		>;
	};

	// Cosmetic layout only, for ZMK Studio's visual key map - key count and
	// order are authoritative (they mirror default_transform/the keymap's
	// bindings exactly), but x/y are an approximate flat grid, not real PCB
	// geometry (see MIGRATION_NOTES.md for why: the only external source of
	// real per-key coordinates we found was internally inconsistent for
	// anything past the first 20 keys). Refine later if you want Studio's
	// editor to visually match the real board.
	default_layout: default_layout {
		compatible = "zmk,physical-layout";
		display-name = "Default";
		transform = <&default_transform>;
		kscan = <&kscan0>;
		keys  =
			<&key_physical_attrs 100 100    0   0 0 0 0>,
			<&key_physical_attrs 100 100  100   0 0 0 0>,
			<&key_physical_attrs 100 100  200   0 0 0 0>,
			<&key_physical_attrs 100 100  300   0 0 0 0>,
			<&key_physical_attrs 100 100  400   0 0 0 0>,
			<&key_physical_attrs 100 100  700   0 0 0 0>,
			<&key_physical_attrs 100 100  800   0 0 0 0>,
			<&key_physical_attrs 100 100  900   0 0 0 0>,
			<&key_physical_attrs 100 100 1000   0 0 0 0>,
			<&key_physical_attrs 100 100 1100   0 0 0 0>,
			<&key_physical_attrs 100 100    0 100 0 0 0>,
			<&key_physical_attrs 100 100  100 100 0 0 0>,
			<&key_physical_attrs 100 100  200 100 0 0 0>,
			<&key_physical_attrs 100 100  300 100 0 0 0>,
			<&key_physical_attrs 100 100  400 100 0 0 0>,
			<&key_physical_attrs 100 100  500 100 0 0 0>,
			<&key_physical_attrs 100 100  800 100 0 0 0>,
			<&key_physical_attrs 100 100  900 100 0 0 0>,
			<&key_physical_attrs 100 100 1000 100 0 0 0>,
			<&key_physical_attrs 100 100 1100 100 0 0 0>,
			<&key_physical_attrs 100 100 1200 100 0 0 0>,
			<&key_physical_attrs 100 100 1300 100 0 0 0>,
			<&key_physical_attrs 100 100    0 200 0 0 0>,
			<&key_physical_attrs 100 100  100 200 0 0 0>,
			<&key_physical_attrs 100 100  200 200 0 0 0>,
			<&key_physical_attrs 100 100  300 200 0 0 0>,
			<&key_physical_attrs 100 100  400 200 0 0 0>,
			<&key_physical_attrs 100 100  500 200 0 0 0>,
			<&key_physical_attrs 100 100  650 200 0 0 0>,
			<&key_physical_attrs 100 100  800 200 0 0 0>,
			<&key_physical_attrs 100 100  950 200 0 0 0>,
			<&key_physical_attrs 100 100 1050 200 0 0 0>,
			<&key_physical_attrs 100 100 1150 200 0 0 0>,
			<&key_physical_attrs 100 100 1250 200 0 0 0>,
			<&key_physical_attrs 100 100 1350 200 0 0 0>,
			<&key_physical_attrs 100 100 1450 200 0 0 0>,
			<&key_physical_attrs 100 100  150 320 0 0 0>,
			<&key_physical_attrs 100 100  250 320 0 0 0>,
			<&key_physical_attrs 100 100  350 320 0 0 0>,
			<&key_physical_attrs 100 100  450 320 0 0 0>,
			<&key_physical_attrs 100 100 1000 320 0 0 0>,
			<&key_physical_attrs 100 100 1100 320 0 0 0>,
			<&key_physical_attrs 100 100 1200 320 0 0 0>,
			<&key_physical_attrs 100 100 1300 320 0 0 0>;
	};
};

&kscan0 {
	row-gpios
		= <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};
