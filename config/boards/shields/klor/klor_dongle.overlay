#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>

/ {
	chosen {
		zmk,kscan = &mock_kscan;
		zmk,physical-layout = &default_layout;
		zmk,underglow = &led_strip;
	};

	mock_kscan: mock_kscan_0 {
		compatible = "zmk,kscan-mock";
		columns = <0>;
		rows = <0>;
		events = <0>;
	};

	// The dongle has no physical encoders, but the shared keymap's
	// &sensors {...} block (setting triggers-per-rotation) needs these
	// labels to resolve here too - central owns sensor-bindings, so it
	// needs the same zmk,keymap-sensors shape as the halves. Left
	// disabled; the a/b-gpios just reuse the same pro_micro pin refs
	// klor_common.dtsi uses so the alps,ec11 binding validates, even
	// though nothing is physically wired there on this board.
	left_encoder: encoder_left {
		compatible = "alps,ec11";
		label = "LEFT_ENCODER";
		a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <30>;
		status = "disabled";
	};

	right_encoder: encoder_right {
		compatible = "alps,ec11";
		label = "RIGHT_ENCODER";
		a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <30>;
		status = "disabled";
	};

	sensors: sensors {
		compatible = "zmk,keymap-sensors";
		sensors = <&left_encoder &right_encoder>;
	};

	// Haptic feedback send side - the dongle has no DRV2605/LRA of its
	// own, so lra0_relay is a proxy: triggering &ob_lra0 broadcasts to
	// both halves over BLE via zmk-split-peripheral-output-relay
	// (relay-channel 201, matching klor_common.dtsi's receive side on
	// each half - see MIGRATION_NOTES.md, untested end to end).
	lra0_relay: lra0_relay {
		compatible = "zmk,output-split-output-relay";
		#binding-cells = <0>;
	};

	output_relay_config_201: output_relay_config_201 {
		compatible = "zmk,split-peripheral-output-relay";
		device = <&lra0_relay>;
		relay-channel = <201>;
	};

	ob_lra0: ob_generic_lra0 {
		compatible = "zmk,output-behavior-generic";
		#binding-cells = <0>;
		device = <&lra0_relay>;
		/* 7 = "Soft Bump" at 100%, per zmk-output-behavior-listener's README */
		force = <7>;
	};

	// Piezo beep send side - same proxy pattern as the haptic relay
	// above, separate channel (202) so it doesn't collide with it.
	piezo0_relay: piezo0_relay {
		compatible = "zmk,output-split-output-relay";
		#binding-cells = <0>;
	};

	output_relay_config_202: output_relay_config_202 {
		compatible = "zmk,split-peripheral-output-relay";
		device = <&piezo0_relay>;
		relay-channel = <202>;
	};

	ob_piezo0: ob_generic_piezo0 {
		compatible = "zmk,output-behavior-generic";
		#binding-cells = <0>;
		device = <&piezo0_relay>;
		/* PWM duty cycle (0-256ish) driving the 2kHz tone set on the
		 * peripheral's pwm_piezo0 node - not a frequency, that's fixed
		 * at devicetree level on the receiving end. */
		force = <128>;
	};

	// Trigger on entering RAISE or LOWER: haptic buzz + piezo beep
	// together. Layer indices are klor.keymap's raw values (BASE=0
	// RAISE=1 LOWER=2 ADJUST=3) spelled out as plain integers - this
	// file is preprocessed separately from klor.keymap, so its
	// #defines aren't visible here. 1 = OUTPUT_SOURCE_LAYER_STATE_CHANGE.
	lra0_obl__enter_raise_or_lower: lra0_obl__enter_raise_or_lower {
		compatible = "zmk,output-behavior-listener";
		layers = <1 2>; /* RAISE, LOWER */
		sources = <1>;  /* OUTPUT_SOURCE_LAYER_STATE_CHANGE */
		bindings = <&ob_lra0 &ob_piezo0>;
	};

	// Must match klor.dtsi's default_transform exactly (same node name,
	// same map) - ZMK requires identical matrix transforms/physical
	// layouts, with identical devicetree node names, across every part
	// of a split. Not #included from klor.dtsi because the dongle has
	// no kscan0/oled/encoders to pull in along with it.
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <4>;
		map = <
        RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,5) RC(3,6) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,7) RC(3,8) RC(3,9) RC(3,10)
		>;
	};

	// Same cosmetic caveat as klor.dtsi's copy - see MIGRATION_NOTES.md.
	// kscan here points at the mock kscan rather than a real one.
	default_layout: default_layout {
		compatible = "zmk,physical-layout";
		display-name = "Default";
		transform = <&default_transform>;
		kscan = <&mock_kscan>;
		keys  =
			<&key_physical_attrs 100 100    0   0 0 0 0>,
			<&key_physical_attrs 100 100  100   0 0 0 0>,
			<&key_physical_attrs 100 100  200   0 0 0 0>,
			<&key_physical_attrs 100 100  300   0 0 0 0>,
			<&key_physical_attrs 100 100  400   0 0 0 0>,
			<&key_physical_attrs 100 100  700   0 0 0 0>,
			<&key_physical_attrs 100 100  800   0 0 0 0>,
			<&key_physical_attrs 100 100  900   0 0 0 0>,
			<&key_physical_attrs 100 100 1000   0 0 0 0>,
			<&key_physical_attrs 100 100 1100   0 0 0 0>,
			<&key_physical_attrs 100 100    0 100 0 0 0>,
			<&key_physical_attrs 100 100  100 100 0 0 0>,
			<&key_physical_attrs 100 100  200 100 0 0 0>,
			<&key_physical_attrs 100 100  300 100 0 0 0>,
			<&key_physical_attrs 100 100  400 100 0 0 0>,
			<&key_physical_attrs 100 100  500 100 0 0 0>,
			<&key_physical_attrs 100 100  800 100 0 0 0>,
			<&key_physical_attrs 100 100  900 100 0 0 0>,
			<&key_physical_attrs 100 100 1000 100 0 0 0>,
			<&key_physical_attrs 100 100 1100 100 0 0 0>,
			<&key_physical_attrs 100 100 1200 100 0 0 0>,
			<&key_physical_attrs 100 100 1300 100 0 0 0>,
			<&key_physical_attrs 100 100    0 200 0 0 0>,
			<&key_physical_attrs 100 100  100 200 0 0 0>,
			<&key_physical_attrs 100 100  200 200 0 0 0>,
			<&key_physical_attrs 100 100  300 200 0 0 0>,
			<&key_physical_attrs 100 100  400 200 0 0 0>,
			<&key_physical_attrs 100 100  500 200 0 0 0>,
			<&key_physical_attrs 100 100  650 200 0 0 0>,
			<&key_physical_attrs 100 100  800 200 0 0 0>,
			<&key_physical_attrs 100 100  950 200 0 0 0>,
			<&key_physical_attrs 100 100 1050 200 0 0 0>,
			<&key_physical_attrs 100 100 1150 200 0 0 0>,
			<&key_physical_attrs 100 100 1250 200 0 0 0>,
			<&key_physical_attrs 100 100 1350 200 0 0 0>,
			<&key_physical_attrs 100 100 1450 200 0 0 0>,
			<&key_physical_attrs 100 100  150 320 0 0 0>,
			<&key_physical_attrs 100 100  250 320 0 0 0>,
			<&key_physical_attrs 100 100  350 320 0 0 0>,
			<&key_physical_attrs 100 100  450 320 0 0 0>,
			<&key_physical_attrs 100 100 1000 320 0 0 0>,
			<&key_physical_attrs 100 100 1100 320 0 0 0>,
			<&key_physical_attrs 100 100 1200 320 0 0 0>,
			<&key_physical_attrs 100 100 1300 320 0 0 0>;
	};
};

// The dongle has no LED strip, but rgb_underglow.c hard-requires a
// zmk,underglow chosen node to compile at all (confirmed via CI: same
// "#error must be declared" pattern as the DISPLAY chosen requirement
// hit earlier) - without this, CONFIG_ZMK_RGB_UNDERGLOW can't be
// enabled here, and RAISE's RGB_TOG/etc. silently no-op since there's
// no behavior code to run them. This placeholder satisfies the
// compiler on an SPI bus nothing else uses on this board; chain-length
// 1 means it's a single phantom LED that's never physically wired to
// anything, not a real strip. What matters is that RGB underglow's
// "global" split-sync behavior can now actually run FROM the dongle,
// relaying to the halves' real strips.
&pinctrl {
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
		};
	};

	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
			low-power-enable;
		};
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";

	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <4000000>;
		chain-length = <1>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN
		                 LED_COLOR_ID_RED
		                 LED_COLOR_ID_BLUE>;
	};
};
