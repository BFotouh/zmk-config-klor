if SHIELD_KLOR_LEFT

    config ZMK_KEYBOARD_NAME
        default "KLOR"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

endif # LEFT



# Not scoped to any one shield - applies to whichever build resolves to
# central (via a shield's own default, or a peripheral cmake-args
# override), left/right/dongle alike. Studio's RPC subsystem costs real
# RAM, so peripherals skip it.
if ZMK_SPLIT_ROLE_CENTRAL

    config ZMK_STUDIO
        default y

endif # ZMK_SPLIT_ROLE_CENTRAL

if SHIELD_KLOR_LEFT || SHIELD_KLOR_RIGHT

    config ZMK_SPLIT
        default y

    config ZMK_RGB_UNDERGLOW
        default y

    # CRITICAL: must stay off. When RGB turns off, zmk_rgb_underglow_off()
    # calls ext_power_disable() if this is enabled - and on nice!nano that
    # is the switched 3.3V header output (P0.13), which on this board feeds
    # the OLED. The display then never comes back, because the SSD1306
    # isn't re-initialized when power returns (upstream zmkfirmware/zmk#674,
    # "OLED Re-init on ext_pwr on"). Worse, ext_power_save_state() persists
    # the off state to NVS on a 60s debounce, so it can survive reboots -
    # and with this symbol off, nothing re-enables the rail automatically;
    # only the &ext_power EP_ON key on ADJUST does.
    #
    # What is NOT on that rail: the LED strip. Established by hardware test
    # - pressing EP_OFF kills the OLED while the underglow keeps animating
    # normally, so the SK6812s run from unswitched power (which also makes
    # sense at 21 LEDs, far more current than that rail should carry). An
    # earlier revision of this comment claimed the rail fed both; it does
    # not. Consequence: the underglow can never be truly powered down from
    # firmware. The most that AUTO_OFF_IDLE below can do is write black,
    # leaving the controllers' ~1mA each quiescent draw (~20mA for 21).
    #
    # This override DOES take effect. app/Kconfig sources this file
    # ($(ZMK_CONFIG)/boards/shields/*/Kconfig.defconfig, ~line 721) BEFORE
    # its own Kconfig.defaults (~line 725, where ZMK sets "default y"), and
    # Kconfig honors the first default in parse order. Contrast
    # ZMK_DISPLAY_BLANK_ON_IDLE, which can NOT be overridden from here: its
    # "default y if SSD1306" lives at its definition site in
    # src/display/Kconfig, sourced at ~line 284 - earlier than this file.
    # That one needs a CONFIG_ line in klor.conf instead. Same rule
    # explains both, and it is the thing that keeps biting here.
    config ZMK_RGB_UNDERGLOW_EXT_POWER
        default n

    # Underglow goes dark after CONFIG_ZMK_IDLE_TIMEOUT (30s) and returns
    # on the next keypress. Safe now that RGB_UNDERGLOW_EXT_POWER is off:
    # this only writes black to the strip, it no longer drags the OLED's
    # rail down with it.
    #
    # Known, accepted wart: zmk_rgb_underglow_off() persists on=false to
    # NVS, and rgb_settings_set() restores that over
    # ZMK_RGB_UNDERGLOW_ON_START at boot. rgb_underglow_auto_state() then
    # latches it - the first idle records rgb_state_before_sleeping=false,
    # so the matching wake calls off() again. So after a full power cycle
    # the underglow comes up dark and stays dark until someone presses
    # RGB_TOG (RAISE + Q) once. ZMK offers no way to get idle-off without
    # that flash write; there is no per-subsystem persistence toggle, and
    # raising ZMK_SETTINGS_SAVE_DEBOUNCE to dodge it would also delay BLE
    # profile and ext_power saves. One keypress per power-on was judged
    # the better trade against leaving 21 LEDs lit continuously.
    config ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE
        default y

    # Deliberately NOT set here:
    #  * ZMK_RGB_UNDERGLOW_AUTO_OFF_USB - kills RGB whenever USB is
    #    disconnected, which for a dongle setup means "always", since the
    #    halves normally run wireless.
    #  * ZMK_SLEEP - deep sleep cuts the same ext_power rail, with the same
    #    persisted-off consequence for the OLED described above.

    config ZMK_DISPLAY
        default y

    # ZMK_DISPLAY_BLANK_ON_IDLE left at ZMK's stock default (y). The OLED
    # going permanently dark was never display blanking - it was the
    # ext_power rail being cut out from under it (see above). It could not
    # be forced from this file anyway; see the parse-order note.

if ZMK_DISPLAY

    config I2C
        default y

    config SSD1306
        default y

endif # ZMK_DISPLAY



if LVGL

    config LV_Z_VDB_SIZE
        default 64

    config LV_DPI_DEF
        default 148

    config LV_Z_BITS_PER_PIXEL
        default 1

    choice LV_COLOR_DEPTH
        default LV_COLOR_DEPTH_1
    endchoice

endif # LVGL


endif # LEFT RIGHT



if SHIELD_KLOR_DONGLE

    # The dongle has no LED strip of its own, but RAISE's RGB_TOG/etc.
    # bindings are processed here (keymap logic is central-only) -
    # without this, ZMK doesn't compile in behavior_rgb_underglow.c at
    # all on this build, so pressing those keys silently does nothing.
    # Confirmed via a real hardware test that this is NOT the cause of
    # the halves' OLED wake-from-idle bug (disabling this entirely
    # didn't change that behavior at all) - restoring it.
    config ZMK_RGB_UNDERGLOW
        default y

    # Max 16 characters
    config ZMK_KEYBOARD_NAME
        default "KLOR"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

    config ZMK_SPLIT
        default y

    # Left + right = 2 peripherals
    config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
        default 2

    # 2 peripherals + 5 BT profiles
    config BT_MAX_CONN
        default 7

    config BT_MAX_PAIRED
        default 7

endif # DONGLE
