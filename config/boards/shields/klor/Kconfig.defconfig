if SHIELD_KLOR_LEFT

    config ZMK_KEYBOARD_NAME
        default "KLOR"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

endif # LEFT



# Not scoped to any one shield - applies to whichever build resolves to
# central (via a shield's own default, or a peripheral cmake-args
# override), left/right/dongle alike. Studio's RPC subsystem costs real
# RAM, so peripherals skip it.
if ZMK_SPLIT_ROLE_CENTRAL

    config ZMK_STUDIO
        default y

endif # ZMK_SPLIT_ROLE_CENTRAL

if SHIELD_KLOR_LEFT || SHIELD_KLOR_RIGHT

    config ZMK_SPLIT
        default y

    config ZMK_RGB_UNDERGLOW
        default y

    # Power saving: RGB turns off after CONFIG_ZMK_IDLE_TIMEOUT (30s
    # default) of inactivity - the same timeout that already blanks the
    # OLED via ZMK_DISPLAY_BLANK_ON_IDLE.
    #
    # Deliberately NOT set here, both learned the hard way:
    #  * ZMK_RGB_UNDERGLOW_AUTO_OFF_USB - kills RGB whenever USB is
    #    disconnected, which for a dongle setup means "always", since
    #    the halves normally run wireless.
    #  * ZMK_SLEEP - deep sleep cuts the EXT_POWER rail, and on
    #    nice!nano that rail feeds BOTH the OLED and the LED strip, so
    #    it takes out the display and underglow together. ZMK persists
    #    that off state, so it survives reboots. If deep sleep is worth
    #    revisiting for battery life later, do it only alongside the
    #    &ext_power EP_ON recovery binding on the ADJUST layer.
    config ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE
        default y

    config ZMK_DISPLAY
        default y

if ZMK_DISPLAY

    config I2C
        default y

    config SSD1306
        default y

endif # ZMK_DISPLAY



if LVGL

    config LV_Z_VDB_SIZE
        default 64

    config LV_DPI_DEF
        default 148

    config LV_Z_BITS_PER_PIXEL
        default 1

    choice LV_COLOR_DEPTH
        default LV_COLOR_DEPTH_1
    endchoice

endif # LVGL


endif # LEFT RIGHT



if SHIELD_KLOR_DONGLE

    # Max 16 characters
    config ZMK_KEYBOARD_NAME
        default "KLOR"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

    config ZMK_SPLIT
        default y

    # Left + right = 2 peripherals
    config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
        default 2

    # 2 peripherals + 5 BT profiles
    config BT_MAX_CONN
        default 7

    config BT_MAX_PAIRED
        default 7

endif # DONGLE
