if SHIELD_KLOR_LEFT

    config ZMK_KEYBOARD_NAME
        default "KLOR"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

endif # LEFT



if SHIELD_KLOR_LEFT || SHIELD_KLOR_RIGHT

    config ZMK_SPLIT
        default y

# Only whichever build actually resolves to central (either via the
# default above, or via a peripheral cmake-args override) gets Studio's
# RPC subsystem built in - it costs real RAM, so peripherals skip it.
if ZMK_SPLIT_ROLE_CENTRAL

    config ZMK_STUDIO
        default y

endif # ZMK_SPLIT_ROLE_CENTRAL

if ZMK_DISPLAY

    config I2C
        default y

    config SSD1306
        default y

endif # ZMK_DISPLAY



if LVGL

    config LV_Z_VDB_SIZE
        default 64

    config LV_DPI_DEF
        default 148

    config LV_Z_BITS_PER_PIXEL
        default 1

    choice LV_COLOR_DEPTH
        default LV_COLOR_DEPTH_1
    endchoice

endif # LVGL


endif # LEFT RIGHT
