if SHIELD_KLOR_LEFT

    config ZMK_KEYBOARD_NAME
        default "KLOR"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

endif # LEFT



# Not scoped to any one shield - applies to whichever build resolves to
# central (via a shield's own default, or a peripheral cmake-args
# override), left/right/dongle alike. Studio's RPC subsystem costs real
# RAM, so peripherals skip it.
if ZMK_SPLIT_ROLE_CENTRAL

    config ZMK_STUDIO
        default y

endif # ZMK_SPLIT_ROLE_CENTRAL

if SHIELD_KLOR_LEFT || SHIELD_KLOR_RIGHT

    config ZMK_SPLIT
        default y

    config ZMK_RGB_UNDERGLOW
        default y

    # Power saving: RGB turns off after CONFIG_ZMK_IDLE_TIMEOUT (30s
    # default) of inactivity.
    #
    # Deliberately NOT set here:
    #  * ZMK_RGB_UNDERGLOW_AUTO_OFF_USB - kills RGB whenever USB is
    #    disconnected, which for a dongle setup means "always", since
    #    the halves normally run wireless.
    #  * ZMK_SLEEP - deep sleep cuts the EXT_POWER rail and ZMK persists
    #    that off state, surviving reboots, with no bound recovery key
    #    at the time this was tried. (Turned out unrelated to the OLED
    #    issue below - EXT_POWER only gates this board's own onboard
    #    regulator pin, not a rail shared with the halves' OLED/LED -
    #    but still not worth deep sleep's downside without revisiting
    #    the recovery story properly.)
    config ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE
        default y

    config ZMK_DISPLAY
        default y

    # Deliberately disabled, confirmed via real hardware testing: ZMK's
    # SSD1306 driver doesn't re-run its init sequence after the display
    # is blanked, so it goes dark on idle and never comes back - unlike
    # RGB_UNDERGLOW_AUTO_OFF_IDLE above, which works fine because
    # "waking" an LED strip just means writing fresh color data, not
    # reinitializing a whole controller chip. This is a known, still-
    # open upstream ZMK bug (zmkfirmware/zmk#674), not something in this
    # config - an always-on OLED beats a permanently-dark one.
    config ZMK_DISPLAY_BLANK_ON_IDLE
        default n

if ZMK_DISPLAY

    config I2C
        default y

    config SSD1306
        default y

endif # ZMK_DISPLAY



if LVGL

    config LV_Z_VDB_SIZE
        default 64

    config LV_DPI_DEF
        default 148

    config LV_Z_BITS_PER_PIXEL
        default 1

    choice LV_COLOR_DEPTH
        default LV_COLOR_DEPTH_1
    endchoice

endif # LVGL


endif # LEFT RIGHT



if SHIELD_KLOR_DONGLE

    # The dongle has no LED strip of its own, but RAISE's RGB_TOG/etc.
    # bindings are processed here (keymap logic is central-only) -
    # without this, ZMK doesn't compile in behavior_rgb_underglow.c at
    # all on this build, so pressing those keys silently does nothing
    # (confirmed via real hardware testing - RAISE itself activated
    # fine, RGB_TOG specifically no-opped). RGB underglow is one of
    # ZMK's "global" behaviors - designed to auto-relay from whichever
    # device processes the keymap to every part with actual underglow
    # hardware - but that only works if the sending device has the
    # behavior compiled in to begin with.
    config ZMK_RGB_UNDERGLOW
        default y

    # Max 16 characters
    config ZMK_KEYBOARD_NAME
        default "KLOR"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

    config ZMK_SPLIT
        default y

    # Left + right = 2 peripherals
    config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
        default 2

    # 2 peripherals + 5 BT profiles
    config BT_MAX_CONN
        default 7

    config BT_MAX_PAIRED
        default 7

endif # DONGLE
